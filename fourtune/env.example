# 백엔드 서버 주소
# '/' 로 두면 Axios가 프론트엔드 도메인(Localhost:5173)의 Root에서부터 API를 요청하게 되며,
# 이는 vite.config.ts의 Proxy 설정에 의해 각 MSA 포트로 적절히 분배됩니다.
VITE_BACKEND_URL=/

# Mock 모드 설정
# true: 내부 Mock 데이터 사용 (백엔드 연결 안 함)
# false: 실제 백엔드 연결 (Vite Proxy를 통해 로컬 MSA 포트로 연결)
VITE_USE_MOCK=false

# PG 결제 (토스페이먼츠)
# Toss Developers > API 키 > 클라이언트 키
VITE_TOSS_CLIENT_KEY=test_ck_YOUR_CLIENT_KEY
